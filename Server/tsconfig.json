{
  // Visit https://aka.ms/tsconfig to read more about this file
  "compilerOptions": {
    "module": "NodeNext",           // commonjs is fine for Node.js
    "target": "ES2020",           // modern JS features
    "moduleResolution": "NodeNext",   // important for Node imports
    "strict": true,
    "esModuleInterop": true,      // allows import express from 'express'
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": ["node"],             // include Node.js types
    "resolveJsonModule": true,
    "outDir": "./dist",             // output directory for compiled files
    "rootDir": "../"
  },
    "include": [
      "../Server/**/*.ts",
      "../Shared/**/*.ts"
    ]       // include all TypeScript files
}
